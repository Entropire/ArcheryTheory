<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="ArcheryTheory – this website is in development." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>ArcheryTheory – in development</title>
  </head>
  <body>
    <main>
      <h1 class="logo" role="img" aria-label="Archery Theory"></h1>
      <p class="status">This website is in development</p>
    </main>
  </body>
</html>

<style is:global>
  :root {
    --color-bg: #fbfaf7;
    --color-text: #1d1d1b;
    --color-brand: #183930;
    color-scheme: light dark;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --color-bg: #161614;
      --color-text: #ecebe6;
      --color-brand: #e6efe9;
    }
  }

  body {
    margin: 0;
    min-height: 100vh;
    display: grid;
    place-items: center;
    background: var(--color-bg);
    color: var(--color-text);
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    line-height: 1.6;
    text-align: center;
  }

  main {
    max-width: 32rem;
    padding: 2rem 1rem;
  }

  /* The stacked logo is used as a mask so it takes the theme color in light and dark mode. */
  .logo {
    width: min(30rem, 85vw);
    aspect-ratio: 640 / 280;
    margin: 0 auto 2rem;
    background-color: var(--color-brand);
    mask: url('/logo/archery-theory-stacked.svg') center / contain no-repeat;
  }

  .status {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 600;
  }
</style>
